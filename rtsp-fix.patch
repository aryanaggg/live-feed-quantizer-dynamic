+def _mask_url(url: str) -> str:
+    """Hide the password in rtsp://user:pass@host/... before logging it."""
+    return re.sub(r"(://[^:/@]+:)[^/]*@", r"\1***@", url)
+
+
+class _RtspCap:
+    """cv2.VideoCapture wrapper. Every blocking call (open / grab / release) is meant to
+    run in a worker thread, serialised by a lock (VideoCapture is not thread-safe)."""
+
+    def __init__(self, url: str):
+        self.lock = threading.Lock()
+        try:  # OpenCV >= 4.5.2: bound how long open/read may block
+            self.cap = cv2.VideoCapture(
+                url, cv2.CAP_FFMPEG,
+                [cv2.CAP_PROP_OPEN_TIMEOUT_MSEC, 5000, cv2.CAP_PROP_READ_TIMEOUT_MSEC, 5000],
+            )
+        except TypeError:
+            self.cap = cv2.VideoCapture(url, cv2.CAP_FFMPEG)
+        try:
+            self.cap.set(cv2.CAP_PROP_BUFFERSIZE, 1)
+        except Exception:
+            pass
+
+    def opened(self) -> bool:
+        return self.cap.isOpened()
+
+    def read_latest(self):
+        """Drop stale buffered frames, return the newest frame (or None)."""
+        with self.lock:
+            got = False
+            for _ in range(3):
+                if not self.cap.grab():
+                    break
+                got = True
+            if not got:
+                return None
+            ok, frame = self.cap.retrieve()
+            return frame if ok else None
+
+    def close(self) -> None:
+        with self.lock:
+            self.cap.release()
+
+
