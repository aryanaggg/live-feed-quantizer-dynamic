-                        break
-                ret, frame = await asyncio.to_thread(cap.retrieve)
-                if not ret or frame is None:
-                    await asyncio.sleep(0.01)
+            if rc is None:
+                try:
+                    rc = await asyncio.wait_for(asyncio.to_thread(_RtspCap, rtsp_url), timeout=15)
+                except asyncio.TimeoutError:
+                    rc = None
+                if rc is None or not rc.opened():
+                    if rc is not None:
+                        loop.run_in_executor(None, rc.close)
+                        rc = None
+                    logger.warning("[CAMERA] Failed to open RTSP stream: %s", _mask_url(rtsp_url))
+                    await send_json(websocket, {"type": "error", "detail": "rtsp_open_failed"})
+                    await asyncio.sleep(3)
                     continue
+                misses = 0
+                announced = False
+
+            try:
+                frame = await asyncio.to_thread(rc.read_latest)
+                if frame is None:
+                    misses += 1
+                    if misses >= 5:
+                        logger.warning("[CAMERA] RTSP stream lost, reopening")
+                        loop.run_in_executor(None, rc.close)
+                        rc = None
+                        await send_json(websocket, {"type": "error", "detail": "rtsp_stream_lost"})
+                    else:
+                        await asyncio.sleep(0.05)
+                    continue
+                misses = 0
+                if not announced:
+                    announced = True
+                    await send_json(websocket, {"type": "status", "detail": "camera_connected"})
 
