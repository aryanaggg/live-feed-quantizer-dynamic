+    """Background task: open an RTSP stream via OpenCV and push frames over WS.
 
+    All blocking OpenCV calls run in worker threads, so a dead or slow camera can no
+    longer freeze the event loop. "camera_connected" is sent only after the first real
+    frame; open failures / dropped streams are reported and retried.
+    """
+    logger.info("[CAMERA] RTSP stream loop started for %s", _mask_url(rtsp_url))
+    loop = asyncio.get_running_loop()
+    rc = None
+    announced = False
+    misses = 0
+    try:
         while not stop_event.is_set():
